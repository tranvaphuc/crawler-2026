# Application
NODE_ENV=development
PORT=3000
BOARD_PORT=3001
PUBLIC_API_URL=

# Datastores
MONGO_URI=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Elasticsearch migration sources/target
ES5_HOST=
ES7_HOST=
ES8_HOST=
ES8_PORT=9200
ES8_USER=
ES8_PASS=
ES9_HOST=
ES9_PORT=57095
ES9_USER=
ES9_PASS=
ES9_PROTOCOL=https

# ES5 -> ES9 migration from 2026-10-01 00:00 Asia/Ho_Chi_Minh
ES5_TO_ES9_START=2026-09-30T17:00:00.000Z
ES5_TO_ES9_SLICES=4
ES5_TO_ES9_RECENT_OVERLAP_HOURS=2
ES5_TO_ES9_RECENT_SLICES=4
ES9_MASTER_SHARDS=1
ES9_MASTER_REPLICAS=0
ES9_MASTER_REFRESH_INTERVAL=30s

# Omachi ES5 -> MongoDB import and ES7 enrichment
MONGO_OMACHI_HOST=127.0.0.1
MONGO_OMACHI_PORT=59099
MONGO_OMACHI_DB=omachi
MONGO_OMACHI_COLLECTION=buzzes
MONGO_OMACHI_IMPORT_USER=omachiImporter
MONGO_OMACHI_IMPORT_PASS=
KEYWORD_FOR_OMACHI=[]
OMACHI_ES5_INDEX=auto
OMACHI_ES7_INDEX=topic5d556d546d35efe10b97f310
OMACHI_SYNC_DATE_FIELD=publishedDate
OMACHI_SYNC_START=2026-08-31T17:00:00.000Z

# Optional crawler/runtime settings
GRAPH_ACCESS_TOKEN=
PYTHON_CMD=python3
QUEUE_NAMES=

# Optional private named proxy pool configuration; do not commit keys.
SOCIAL_METRICS_PROXY_POOLS_FILE=

# Public API: all requests require Authorization: Bearer <AUTHEN_KEY_FOR_DOMAIN>.
DOMAIN_FOR_API=
AUTHEN_KEY_FOR_DOMAIN=
PUBLIC_API_HOST=127.0.0.1
PUBLIC_API_PORT=3805

# Optional persistent upstream Retry-After state; contains only platform deadlines.
SOCIAL_PLATFORM_COOLDOWN_FILE=

# Shared private proxy manager. Provider keys are kept only by this service.
PROXY_MANAGER_URL=http://127.0.0.1:3810
PROXY_MANAGER_AUTH_KEY=
PROXY_MANAGER_ADMIN_KEY=
PROXY_MANAGER_HOST=127.0.0.1
PROXY_MANAGER_PORT=3810
PROXY_MANAGER_KEYS_FILE=
PROXY_MANAGER_SETTINGS_FILE=
PROXY_MANAGER_STATE_FILE=

# Private TikTok interaction provider (server-side only)
TIKTOK_INTERACTION_API_URL=http://158.69.200.161/tiktok/interaction
TIKTOK_INTERACTION_API_KEY=

# Optional server-owned Facebook login session for comment/reply reads.
# Private JSON file with accountId and cookie; never pass credentials in API bodies.
FACEBOOK_COMMENT_SESSION_FILE=
