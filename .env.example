# Application
NODE_ENV=development
PORT=3000
BOARD_PORT=3001
PUBLIC_API_URL=

# Datastores
MONGO_URI=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Elasticsearch migration sources/target
ES5_HOST=
ES7_HOST=
ES8_HOST=
ES8_PORT=9200
ES8_USER=
ES8_PASS=
ES9_HOST=
ES9_PORT=57095
ES9_USER=
ES9_PASS=
ES9_PROTOCOL=https

# ES5 -> ES9 migration from 2026-10-01 00:00 Asia/Ho_Chi_Minh
ES5_TO_ES9_START=2026-09-30T17:00:00.000Z
ES5_TO_ES9_SLICES=4
ES5_TO_ES9_RECENT_OVERLAP_HOURS=2
ES5_TO_ES9_RECENT_SLICES=4
ES9_MASTER_SHARDS=1
ES9_MASTER_REPLICAS=0
ES9_MASTER_REFRESH_INTERVAL=30s

# Optional crawler/runtime settings
GRAPH_ACCESS_TOKEN=
PYTHON_CMD=python3
QUEUE_NAMES=
