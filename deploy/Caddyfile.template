DOMAIN_PLACEHOLDER {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        -Server
    }
    request_body {
        max_size 40KB
    }
    reverse_proxy 127.0.0.1:3805 {
        transport http {
            dial_timeout 5s
            response_header_timeout 120s
        }
    }
}
