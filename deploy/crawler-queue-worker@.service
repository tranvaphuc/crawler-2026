[Unit]
Description=Social crawler worker role %i
After=network-online.target redis-server.service crawler-proxy-manager.service
Wants=network-online.target crawler-proxy-manager.service
Requires=redis-server.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=crawler-v8
Group=crawler-api
WorkingDirectory=/opt/crawler-v8/current
EnvironmentFile=/etc/crawler-v8/runtime.env
EnvironmentFile=/etc/crawler-v8/roles/%i.env
ExecStart=/opt/crawler-node/bin/node --max-old-space-size=2500 /opt/crawler-v8/current/scripts/crawler_queue_flow.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=240
LimitNOFILE=65536
MemoryMax=3500M
Slice=crawler-workers.slice
TasksMax=1024
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/crawler-v8
