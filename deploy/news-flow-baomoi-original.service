[Unit]
Description=Baomoi original articles and publisher qualification
Wants=network-online.target
Requires=news-flow-egress.service
After=network-online.target news-flow-egress.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=120s
User=news-flow
Group=news-flow
Slice=news-flow.slice
WorkingDirectory=/opt/news-flow/current
Environment=NODE_ENV=production
ExecStart=/usr/bin/flock --exclusive --nonblock --no-fork /var/lib/news-flow/locks/baomoi-original.lock /opt/news-flow/node/bin/node --max-old-space-size=256 scripts/run_baomoi_original_branch.mjs
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/news-flow
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G
CPUQuota=100%
TasksMax=24

[Install]
WantedBy=multi-user.target
