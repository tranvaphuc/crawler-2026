[Unit]
Description=Forum ES5 identity reconciliation and outbox writer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=forum-flow
Group=forum-flow
WorkingDirectory=/opt/forum-flow/current
Environment=NODE_ENV=production
ExecStart=/opt/forum-flow/node/bin/node --max-old-space-size=128 scripts/run_forum_writer.mjs --continuous --write --state /var/lib/forum-flow/runtime/state.sqlite --proof /etc/forum-flow/identity-proof.json --report /var/lib/forum-flow/runtime/writer-report.json --limit 100
Restart=always
RestartSec=20
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/forum-flow
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
LimitCORE=0
CPUQuota=25%
CPUWeight=20
TasksMax=24

[Install]
WantedBy=multi-user.target
