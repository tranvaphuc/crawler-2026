{
  "name": "node-babel-starter",
  "version": "1.0.0",
  "description": "Starter Node.js project with Babel, Nodemon, ESLint",
  "main": "dist/index.js",
  "type": "module",
  "packageManager": "npm@8.19.4",
  "scripts": {
    "dev": "nodemon src/index.js",
    "build": "babel src -d dist",
    "start": "node dist/index.js",
    "monitor": "node src/index.js",
    "facebook:master": "node src/queues/facebook/master.js",
    "facebook:token": "node src/queues/facebook/tokenMaster.js",
    "worker:facebook": "node src/queues/facebook/worker.js",
    "pm2:start": "npx pm2 start ecosystem.config.cjs",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "pm2:restart": "npx pm2 restart ecosystem.config.cjs",
    "pm2:logs": "npx pm2 logs",
    "pm2:migrations:start": "npx pm2 start ecosystem.migrations.config.cjs",
    "pm2:migrations:stop": "npx pm2 stop ecosystem.migrations.config.cjs",
    "pm2:migrations:restart": "npx pm2 restart ecosystem.migrations.config.cjs",
    "pm2:migrations:logs": "npx pm2 logs migration-es7-to-es8-full migration-es7-to-es8-recent migration-es5-to-es8-aug-full migration-es5-to-es8-recent-6h",
    "es9:template:deploy": "node scripts/deploy_master_template_es9.mjs",
    "es5:es9:plan": "node scripts/migrate_es5_oct2026_to_es9.mjs --plan",
    "es5:es9:pm2:start": "npx pm2 start ecosystem.es5-to-es9.config.cjs",
    "es5:es9:recent": "node scripts/sync_es5_recent_to_es9.mjs",
    "es5:es9:pm2:logs": "npx pm2 logs migration-es5-to-es9-oct-2026 sync-es5-to-es9-recent",
    "pm2:push": "node src/queues/facebook/master.js",
    "pm2:push-token": "node src/queues/facebook/tokenMaster.js",
    "test:fb-scraper": "node test/run-fb-scraper.js",
    "vnexpress": "node test/vnexpress.js",
    "hanoimoi": "node test/hanoimoi.js",
    "hanoimoi:detail": "node test/hanoimoi-article-detail.js",
    "hanoimoi:getmore": "node test/hanoimoi-getmore-article.js",
    "batdongsan:detail": "node test/batdongsan-detail.js",
    "batdongsan:hcm": "node test/batdongsan-hcm-5-pages.js",
    "batdongsan:hcm:excel": "node scripts/build-batdongsan-hcm-excel.mjs",
    "batdongsan:hcm:all": "npm run batdongsan:hcm && npm run batdongsan:hcm:excel",
    "es7:profiles": "node scripts/update-es7-profiles.mjs",
    "es7:gender": "node scripts/normalize-es7-gender.mjs",
    "time": "node test/time.js",
    "lint": "eslint .",
    "test": "node test/normalize-es7-gender.test.mjs"
  },
  "engines": {
    "node": ">=16.20.2"
  },
  "overrides": {
    "@bull-board/express": {
      "express": "4.22.2"
    },
    "browserslist": "4.27.0",
    "node-releases": "2.0.27"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "eslint": "^8.57.1",
    "globals": "^13.24.0",
    "nodemon": "3.1.10",
    "pm2": "^5.4.3"
  },
  "dependencies": {
    "@bull-board/api": "6.12.0",
    "@bull-board/express": "6.12.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "axios": "^1.13.6",
    "bullmq": "5.70.4",
    "cheerio": "1.0.0-rc.12",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "elasticsearch": "^16.7.3",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.5.6",
    "https-proxy-agent": "^8.0.0",
    "ioredis": "^5.10.0",
    "mongoose": "^8.19.1",
    "path": "^0.12.7",
    "puppeteer": "21.11.0",
    "qs": "^6.15.0",
    "redis": "^4.7.1"
  }
}
