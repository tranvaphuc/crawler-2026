{
  "name": "node-babel-starter",
  "version": "1.0.0",
  "description": "Starter Node.js project with Babel, Nodemon, ESLint",
  "main": "dist/index.js",
  "type": "module",
  "packageManager": "npm@8.19.4",
  "scripts": {
    "api:social-metrics": "node scripts/social_metrics_api.mjs",
    "test:social-metrics": "node --test test/social-metrics.test.mjs",
    "api:facebook-share": "node scripts/facebook_share_api.mjs",
    "test:facebook-share": "node --test test/facebook-share.test.mjs",
    "test:facebook-es5": "node --test test/facebook-es5.test.mjs test/facebook-posts.test.mjs test/facebook-comments.test.mjs",
    "demo:facebook-es5": "node scripts/build_facebook_es5_demo.mjs",
    "dev": "nodemon src/index.js",
    "build": "babel src -d dist",
    "start": "node dist/index.js",
    "monitor": "node src/index.js",
    "facebook:master": "node src/queues/facebook/master.js",
    "facebook:token": "node src/queues/facebook/tokenMaster.js",
    "worker:facebook": "node src/queues/facebook/worker.js",
    "pm2:start": "npx pm2 start ecosystem.config.cjs",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "pm2:restart": "npx pm2 restart ecosystem.config.cjs",
    "pm2:logs": "npx pm2 logs",
    "pm2:migrations:start": "npx pm2 start ecosystem.migrations.config.cjs",
    "pm2:migrations:stop": "npx pm2 stop ecosystem.migrations.config.cjs",
    "pm2:migrations:restart": "npx pm2 restart ecosystem.migrations.config.cjs",
    "pm2:migrations:logs": "npx pm2 logs migration-es7-to-es8-full migration-es7-to-es8-recent migration-es5-to-es8-aug-full migration-es5-to-es8-recent-6h",
    "es9:template:deploy": "node scripts/deploy_master_template_es9.mjs",
    "es5:es9:plan": "node scripts/migrate_es5_oct2026_to_es9.mjs --plan",
    "es5:es9:pm2:start": "npx pm2 start ecosystem.es5-to-es9.config.cjs",
    "es5:es9:recent": "node scripts/sync_es5_recent_to_es9.mjs",
    "es5:es9:pm2:logs": "npx pm2 logs migration-es5-to-es9-oct-2026 sync-es5-to-es9-recent",
    "pm2:push": "node src/queues/facebook/master.js",
    "pm2:push-token": "node src/queues/facebook/tokenMaster.js",
    "test:fb-scraper": "node test/run-fb-scraper.js",
    "vnexpress": "node test/vnexpress.js",
    "hanoimoi": "node test/hanoimoi.js",
    "hanoimoi:detail": "node test/hanoimoi-article-detail.js",
    "hanoimoi:getmore": "node test/hanoimoi-getmore-article.js",
    "batdongsan:detail": "node test/batdongsan-detail.js",
    "batdongsan:hcm": "node test/batdongsan-hcm-5-pages.js",
    "batdongsan:hcm:excel": "node scripts/build-batdongsan-hcm-excel.mjs",
    "batdongsan:hcm:all": "npm run batdongsan:hcm && npm run batdongsan:hcm:excel",
    "es7:profiles": "node scripts/update-es7-profiles.mjs",
    "es7:profile-sync": "node scripts/sync-es7-profile-demographics.mjs",
    "es7:gender": "node scripts/normalize-es7-gender.mjs",
    "sync:omachi": "node scripts/sync_omachi_es5_es7_to_mongo.mjs",
    "time": "node test/time.js",
    "lint": "eslint .",
    "test": "node test/normalize-es7-gender.test.mjs",
    "test:profile-sync": "node --test test/sync-es7-profile-demographics.test.mjs",
    "test:social-content": "node --test test/social-content.test.mjs test/social-metrics.test.mjs",
    "api:social": "node scripts/social_metrics_api.mjs",
    "test:apis": "node --test test/interaction-availability.test.mjs test/facebook-reel-metrics.test.mjs test/facebook-metrics-fallback.test.mjs test/facebook-video-metrics.test.mjs test/api-stability.test.mjs test/api-reference-recovery.test.mjs test/proxy-manager.test.mjs test/production-fixes.test.mjs test/api-authentication.test.mjs test/social-system-api.test.mjs test/social-ordering.test.mjs test/social-http.test.mjs test/api-errors.test.mjs test/social-metrics.test.mjs test/social-content.test.mjs test/facebook-share.test.mjs test/facebook-es5.test.mjs test/facebook-posts.test.mjs test/facebook-comments.test.mjs test/facebook-media-identity.test.mjs test/facebook-target-availability.test.mjs test/tiktok-interaction.test.mjs",
    "api:public": "node scripts/public_api.mjs",
    "api:verify-stability": "node scripts/verify_api_stability.mjs",
    "api:proxy-manager": "node scripts/proxy_manager.mjs",
    "proxy:admin": "node scripts/proxy_manager_admin.mjs",
    "crawler:queues": "node scripts/crawler_queue_flow.mjs",
    "crawler:queues:verify": "node scripts/verify_crawler_queue_flow.mjs",
    "crawler:queues:board": "node scripts/crawler_v8_queue_board.mjs",
    "test:crawler-queues": "node --test test/crawler-queue-flow.test.mjs test/meta-source-pagination.test.mjs",
    "news:flow": "node scripts/run_news_flow.mjs",
    "news:preflight": "node scripts/preflight_news_es5.mjs",
    "news:proxies": "node scripts/probe_news_proxies.mjs",
    "test:news-flow": "node --test test/news-flow.test.mjs test/news-flow-transport.test.mjs test/news-runtime-repairs.test.mjs test/news-batch-reader.test.mjs test/news-network-pool.test.mjs"
  },
  "engines": {
    "node": ">=16.20.2"
  },
  "overrides": {
    "@bull-board/express": {
      "express": "4.22.2"
    },
    "browserslist": "4.27.0",
    "node-releases": "2.0.27"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "eslint": "^8.57.1",
    "globals": "^13.24.0",
    "nodemon": "3.1.10",
    "pm2": "^5.4.3"
  },
  "dependencies": {
    "@bull-board/api": "6.12.0",
    "@bull-board/express": "6.12.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "axios": "^1.13.6",
    "bullmq": "5.70.4",
    "cheerio": "1.0.0-rc.12",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "elasticsearch": "^16.7.3",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.5.6",
    "https-proxy-agent": "^8.0.0",
    "ioredis": "^5.10.0",
    "mongoose": "^8.19.1",
    "path": "^0.12.7",
    "puppeteer": "21.11.0",
    "qs": "^6.15.0",
    "redis": "^4.7.1",
    "http-proxy-agent": "^7.0.2"
  }
}
